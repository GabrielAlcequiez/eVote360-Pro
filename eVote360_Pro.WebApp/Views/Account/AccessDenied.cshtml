@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg p-5" style="border-radius: 20px; background: rgba(30, 41, 59, 0.05);">
                <div class="mb-4">
                    <span class="display-1 text-danger d-block font-weight-bold" style="font-size: 6rem; line-height: 1;">403</span>
                    <span class="badge bg-danger px-3 py-2 mt-2" style="font-size: 1rem; border-radius: 30px;">ACCESO RESTRINGIDO</span>
                </div>
                
                <h3 class="mb-3 font-weight-bold" style="color: #0f172a;">Permisos Insuficientes</h3>
                <p class="text-muted mb-4 lead">No tienes los privilegios necesarios para ver esta página. Esta sección es exclusiva para usuarios con el rol de Administrador.</p>
                
                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">Ir al Inicio</a>
                    <a asp-action="Login" asp-controller="Account" class="btn btn-primary px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border: none;">Iniciar Sesión como Admin</a>
                </div>
            </div>
        </div>
    </div>
</div>
