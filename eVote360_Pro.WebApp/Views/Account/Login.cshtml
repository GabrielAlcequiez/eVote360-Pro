@model eVote360_Pro.WebApp.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Acceso Administrativo";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        
        <div class="card shadow-sm border-secondary-subtle">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="h3 font-weight-bold text-dark">eVote360 Pro</h2>
                    <p class="text-muted">Acceso para Personal Administrativo y Dirigentes</p>
                </div>

                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label font-weight-bold">Nombre de Usuario</label>
                        <input asp-for="Username" class="form-control" placeholder="Ej: admin01" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label font-weight-bold">Contraseña</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-2">Iniciar Sesión</button>
                </form>

                <div class="text-center mt-4">
                    <a href="/" class="text-decoration-none small">← Volver al Portal de Votación</a>
                </div>
            </div>
        </div>
    </div>
</div>
