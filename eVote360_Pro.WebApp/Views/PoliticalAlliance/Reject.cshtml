@model eVote360_Pro.Core.Application.DTOs.PoliticalAlliance.PoliticalAllianceGetDto
@{
    ViewData["Title"] = "Rechazar Solicitud de Alianza";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-x-circle-fill text-danger fs-3 me-3"></i>
                        <h1 class="h4 mb-0 text-dark">Confirmar Rechazo</h1>
                    </div>
                    <p class="text-muted mb-4">
                        ¿Está seguro de que desea <strong>rechazar</strong> la solicitud de alianza del partido <strong>@Model.RequesterPartyName (@Model.RequesterPartyAcronym)</strong>?
                    </p>
                    <p class="text-muted small mb-4">
                        Al rechazar, la solicitud quedará marcada como rechazada y el partido solicitante podrá eliminarla de su historial.
                    </p>

                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-x-lg me-1"></i> Sí, rechazar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
