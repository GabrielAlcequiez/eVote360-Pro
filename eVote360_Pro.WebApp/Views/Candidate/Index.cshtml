@model IReadOnlyList<eVote360_Pro.WebApp.Models.Candidate.CandidateGetViewModel>
@{
    ViewData["Title"] = "Mis Candidatos";
    bool hasActiveElection = ViewBag.HasActiveElection;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold mb-1" style="color: #0f172a;">@ViewData["Title"]</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Administra los candidatos de tu partido político.</p>
        </div>
        <div>
            @if (hasActiveElection)
            {
                <button class="btn btn-secondary px-4 py-2" style="border-radius: 10px; cursor: not-allowed;" disabled>
                    + Crear candidato
                </button>
            }
            else
            {
                <a asp-action="Create" class="btn btn-primary px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border: none;">
                    + Crear candidato
                </a>
            }
        </div>
    </div>

    @if (hasActiveElection)
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center gap-3" style="border-radius: 12px; background-color: rgba(245, 158, 11, 0.1); color: #b45309;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>
                <strong style="font-weight: 600;">Modificaciones Bloqueadas:</strong> No se pueden modificar candidatos mientras exista una elección activa.
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 12px; background-color: rgba(16, 185, 129, 0.1); color: #065f46;" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #991b1b;" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-0">No hay candidatos registrados en tu partido político.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var candidate in Model)
            {
                <div class="col">
                    <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                        <div class="card-body d-flex flex-column align-items-center text-center p-4">
                            <!-- Foto -->
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(candidate.Photo))
                                {
                                    <img src="@candidate.Photo" alt="Foto de @candidate.FullName"
                                         class="rounded-circle border shadow-sm"
                                         style="width: 90px; height: 90px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto border shadow-sm"
                                         style="width: 90px; height: 90px;">
                                        <i class="bi bi-person-fill text-muted" style="font-size: 2.5rem;"></i>
                                    </div>
                                }
                            </div>

                            <!-- Nombre -->
                            <h5 class="card-title font-weight-bold mb-1" style="color: #0f172a;">
                                @candidate.FullName
                            </h5>

                            <!-- Partido -->
                            <div class="d-flex align-items-center gap-2 mb-3">
                                @if (!string.IsNullOrEmpty(candidate.PoliticalPartyLogo))
                                {
                                    <img src="@candidate.PoliticalPartyLogo" alt="Logo"
                                         style="width: 22px; height: 22px; object-fit: cover; border-radius: 4px;" />
                                }
                                <span class="text-muted small">
                                    @candidate.PoliticalPartyName
                                    <span class="badge bg-secondary ms-1">@candidate.PoliticalPartyAcronym</span>
                                </span>
                            </div>

                            <!-- Estado -->
                            <div class="mb-3">
                                @if (candidate.IsActive)
                                {
                                    <span class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill"
                                          style="background-color: rgba(16, 185, 129, 0.1); color: #10b981; font-weight: 500; font-size: 0.85rem;">
                                        <span style="width: 7px; height: 7px; background-color: #10b981; border-radius: 50%; display: inline-block;"></span>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill"
                                          style="background-color: rgba(239, 68, 68, 0.1); color: #dc2626; font-weight: 500; font-size: 0.85rem;">
                                        <span style="width: 7px; height: 7px; background-color: #dc2626; border-radius: 50%; display: inline-block;"></span>
                                        Inactivo
                                    </span>
                                }
                            </div>

                            <!-- Acciones -->
                            <div class="d-flex gap-2 mt-auto">
                                @if (hasActiveElection)
                                {
                                    <button class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; cursor: not-allowed;" disabled>
                                        Editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; cursor: not-allowed;" disabled>
                                        @(candidate.IsActive ? "Desactivar" : "Activar")
                                    </button>
                                }
                                else
                                {
                                    <a asp-action="Edit" asp-route-id="@candidate.Id"
                                       class="btn btn-sm btn-outline-primary px-3" style="border-radius: 8px;">
                                        Editar
                                    </a>
                                    <a asp-action="ToggleStatus" asp-route-id="@candidate.Id"
                                       class="btn btn-sm @(candidate.IsActive ? "btn-outline-danger" : "btn-outline-success") px-3"
                                       style="border-radius: 8px;">
                                        @(candidate.IsActive ? "Desactivar" : "Activar")
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
