@model eVote360_Pro.Core.Application.DTOs.PartyLeader.PartyLeaderGetDto
@{
    ViewData["Title"] = "Eliminar Relación de Dirigente";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-4 text-center">
                    <div class="text-danger mb-3">
                        <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    
                    <h1 class="h4 text-dark font-weight-bold mb-3">¿Está seguro que desea desvincular este dirigente político de este partido?</h1>
                    <p class="text-muted mb-4">
                        Al desvincular a <strong>@Model.UserFullName</strong> de <strong>@Model.PoliticalPartyName (@Model.PoliticalPartyAcronym)</strong>, el dirigente no podrá acceder a las funcionalidades del dirigente político hasta que sea asignado a otro partido activo.
                    </p>

                    <div class="d-flex align-items-center justify-content-around p-3 border rounded bg-light mb-4">
                        <div class="text-start">
                            <small class="text-muted d-block">Dirigente Político</small>
                            <span class="font-weight-bold text-dark">@Model.UserFullName</span>
                            <small class="d-block text-muted">(@Model.UserUsername)</small>
                        </div>
                        <div class="border-start ps-3 text-start">
                            <small class="text-muted d-block">Partido Político</small>
                            <span class="font-weight-bold text-dark">@Model.PoliticalPartyName</span>
                            <small class="d-block text-muted">(@Model.PoliticalPartyAcronym)</small>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@Model.UserId" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                Aceptar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
