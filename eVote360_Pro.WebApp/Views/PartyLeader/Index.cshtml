@model eVote360_Pro.WebApp.Models.PartyLeader.PartyLeaderIndexViewModel
@{
    ViewData["Title"] = "Asignación de Dirigentes Políticos";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-dark font-weight-bold">Asignación de Dirigentes Políticos</h1>
        @if (Model.HasActiveElection)
        {
            <button class="btn btn-secondary" disabled>
                <i class="bi bi-link-45deg"></i> Agregar asignación
            </button>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-link-45deg"></i> Agregar asignación
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.HasActiveElection)
    {
        <div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Atención:</strong> No se pueden modificar asignaciones de dirigentes políticos mientras exista una elección activa.
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 bg-white">
        <div class="card-body p-0">
            @if (Model.Assignments == null || Model.Assignments.Count == 0)
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No hay dirigentes políticos asignados a ningún partido actualmente.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Nombre del Dirigente</th>
                                <th>Nombre de Usuario</th>
                                <th>Partido Político Asignado</th>
                                <th>Siglas</th>
                                <th>Estado del Dirigente</th>
                                <th>Estado del Partido</th>
                                <th class="text-end pe-4" style="width: 180px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in Model.Assignments)
                            {
                                <tr>
                                    <td class="ps-4 text-dark font-weight-bold">@assignment.UserFullName</td>
                                    <td class="text-muted">@assignment.UserUsername</td>
                                    <td class="text-dark">@assignment.PoliticalPartyName</td>
                                    <td>
                                        <span class="badge bg-secondary">@assignment.PoliticalPartyAcronym</span>
                                    </td>
                                     <td>
                                         @if (assignment.UserIsActive) 
                                         {
                                             <span class="badge bg-success px-2 py-1">Activo</span>
                                         }
                                         else
                                         {
                                             <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                         }
                                     </td>
                                     <td>
                                          @if (assignment.PoliticalPartyIsActive)
                                         {
                                             <span class="badge bg-success px-2 py-1">Activo</span>
                                         }
                                         else
                                         {
                                             <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                         }
                                     </td>
                                    <td class="text-end pe-4">
                                        @if (Model.HasActiveElection)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled>Eliminar relación</button>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@assignment.UserId" class="btn btn-sm btn-outline-danger">
                                                Eliminar relación
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
