@model eVote360_Pro.WebApp.Models.User.UserUpdateViewModel
@using eVote360_Pro.Core.Domain.Common.Enums
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="mb-3 d-flex align-items-center justify-content-between">
                <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
                    ← Volver al listado
                </a>
            </div>

            <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 20px; background: #ffffff;">
                <div class="mb-4">
                    <h2 class="h3 font-weight-bold mb-1" style="color: #0f172a; font-weight: 700;">@ViewData["Title"]</h2>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">Modifica la información del usuario del sistema.</p>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 p-3 mb-4" style="border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #991b1b; font-size: 0.9rem;"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Nombre</label>
                            <input asp-for="Name" class="form-control" placeholder="Ej: Juan" style="border-radius: 10px; padding: 10px 14px;" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Apellido</label>
                            <input asp-for="LastName" class="form-control" placeholder="Ej: Pérez" style="border-radius: 10px; padding: 10px 14px;" />
                            <span asp-validation-for="LastName" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Correo electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="juan.perez@email.com" style="border-radius: 10px; padding: 10px 14px;" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Nombre de usuario</label>
                        <input asp-for="Username" class="form-control" placeholder="Ej: jperez" style="border-radius: 10px; padding: 10px 14px;" />
                        <span asp-validation-for="Username" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="alert alert-light border-0 mb-3" style="border-radius: 10px; background-color: #f8fafc; border: 1px solid #e2e8f0; font-size: 0.82rem; color: #64748b;">
                        💡 <strong>Nota sobre contraseñas:</strong> Si se dejan vacíos estos campos, se conservará la contraseña actual del usuario.
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Nueva contraseña</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Dejar vacío para mantener" style="border-radius: 10px; padding: 10px 14px;" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Confirmar nueva</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Dejar vacío para mantener" style="border-radius: 10px; padding: 10px 14px;" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Rol en el sistema</label>
                        <select asp-for="Role" class="form-select" style="border-radius: 10px; padding: 10px 14px;">
                            <option value="@Role.Administrator">Administrador</option>
                            <option value="@Role.PoliticalLeader">Dirigente Político</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-4 form-check form-switch pt-2">
                        <input asp-for="IsActive" type="checkbox" class="form-check-input" id="IsActiveSwitch" style="cursor: pointer; width: 2.8em; height: 1.4em;" />
                        <label class="form-check-label ms-2 align-middle" for="IsActiveSwitch" style="font-size: 0.9rem; font-weight: 500; color: #475569;">
                            Usuario Activo (Permite iniciar sesión)
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border: none;">
                            Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
