@model eVote360_Pro.WebApp.Models.User.UserIndexViewModel
@{
    ViewData["Title"] = "Mantenimiento de Usuarios";
    bool hasActiveElection = Model.HasActiveElection;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold mb-1" style="color: #0f172a;">@ViewData["Title"]</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Administra el personal del sistema electoral (Administradores y Dirigentes).</p>
        </div>
        <div>
            @if (hasActiveElection)
            {
                <button class="btn btn-secondary px-4 py-2" style="border-radius: 10px; cursor: not-allowed;" disabled>
                    + Crear usuario
                </button>
            }
            else
            {
                <a asp-action="Create" class="btn btn-primary px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border: none;">
                    + Crear usuario
                </a>
            }
        </div>
    </div>

    <!-- Alerta de Elección Activa -->
    @if (hasActiveElection)
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center gap-3" style="border-radius: 12px; background-color: rgba(245, 158, 11, 0.1); color: #b45309;">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>
                <strong style="font-weight: 600;">Modificaciones Bloqueadas:</strong> No se pueden modificar usuarios mientras exista una elección activa.
            </div>
        </div>
    }

    <!-- Mensajes del Servidor (TempData) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 12px; background-color: rgba(16, 185, 129, 0.1); color: #065f46;" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #991b1b;" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Listado de Usuarios -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden; background: #ffffff;">
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="font-size: 0.95rem;">
                <thead class="bg-light" style="color: #475569; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.8px;">
                    <tr>
                        <th class="px-4 py-3">Nombre</th>
                        <th class="py-3">Usuario</th>
                        <th class="py-3">Correo electrónico</th>
                        <th class="py-3">Rol</th>
                        <th class="py-3">Estado</th>
                        <th class="px-4 py-3 text-end" style="width: 250px;">Acciones</th>
                    </tr>
                </thead>
                <tbody style="color: #334155;">
                    @if (Model.Users == null || !Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <p class="mb-0">No hay usuarios registrados en el sistema.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="border-bottom" style="transition: background 0.2s ease;">
                                <td class="px-4 py-3">
                                    <div class="font-weight-medium" style="color: #0f172a; font-weight: 500;">@user.FullName</div>
                                </td>
                                <td class="py-3 text-muted">@@@user.Username</td>
                                <td class="py-3">@user.Email</td>
                                <td class="py-3">
                                    @if (user.Role == eVote360_Pro.Core.Domain.Common.Enums.Role.Administrator)
                                    {
                                        <span class="badge px-3 py-2" style="background-color: rgba(79, 70, 229, 0.1); color: #4f46e5; border-radius: 30px; font-weight: 500; font-size: 0.8rem;">Administrador</span>
                                    }
                                    else
                                    {
                                        <span class="badge px-3 py-2" style="background-color: rgba(6, 182, 212, 0.1); color: #0891b2; border-radius: 30px; font-weight: 500; font-size: 0.8rem;">Dirigente Político</span>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (user.IsActive)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2" style="color: #10b981; font-weight: 500;">
                                            <span style="width: 8px; height: 8px; background-color: #10b981; border-radius: 50%; display: inline-block;"></span>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-2" style="color: #64748b; font-weight: 500;">
                                            <span style="width: 8px; height: 8px; background-color: #64748b; border-radius: 50%; display: inline-block;"></span>
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <!-- Editar -->
                                        @if (hasActiveElection)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; cursor: not-allowed;" disabled>Editar</button>
                                        }
                                        else
                                        {
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary px-3" style="border-radius: 8px;">Editar</a>
                                        }

                                        <!-- Activar/Desactivar -->
                                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            @if (hasActiveElection)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 8px; cursor: not-allowed;" disabled>
                                                    @(user.IsActive ? "Desactivar" : "Activar")
                                                </button>
                                            }
                                            else
                                            {
                                                @if (user.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3" style="border-radius: 8px;" onclick="return confirm('¿Está seguro de desactivar a este usuario?')">
                                                        Desactivar
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success px-3" style="border-radius: 8px;">
                                                        Activar
                                                    </button>
                                                }
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
