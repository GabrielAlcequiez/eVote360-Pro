@model eVote360_Pro.Core.Application.DTOs.PoliticalParty.PoliticalPartyGetDto
@{
    ViewData["Title"] = Model.IsActive ? "Desactivar Partido" : "Activar Partido";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-4 text-center">
                    @if (Model.IsActive)
                    {
                        <div class="text-danger mb-3">
                            <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                        </div>
                        <h1 class="h4 text-dark font-weight-bold mb-3">¿Está seguro que desea desactivar este partido político?</h1>
                        <p class="text-muted mb-4">
                            Al desactivar <strong>@Model.Name (@Model.Acronym)</strong>, no podrá participar en nuevas configuraciones electorales, alianzas o asignaciones de candidatos.
                        </p>
                    }
                    else
                    {
                        <div class="text-success mb-3">
                            <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                        </div>
                        <h1 class="h4 text-dark font-weight-bold mb-3">¿Está seguro que desea activar este partido político?</h1>
                        <p class="text-muted mb-4">
                            Al activar <strong>@Model.Name (@Model.Acronym)</strong>, volverá a estar disponible para participar en elecciones, alianzas y asignaciones.
                        </p>
                    }

                    <div class="d-flex align-items-center justify-content-center p-3 border rounded bg-light mb-4">
                        @if (!string.IsNullOrEmpty(Model.Logo))
                        {
                            <img src="@Model.Logo" alt="Logo" class="rounded border me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        <div class="text-start">
                            <div class="font-weight-bold text-dark h5 mb-0">@Model.Name</div>
                            <span class="badge bg-secondary">@Model.Acronym</span>
                        </div>
                    </div>

                    <form asp-action="ToggleStatus" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                            @if (Model.IsActive)
                            {
                                <button type="submit" class="btn btn-danger px-4">
                                    Desactivar Partido
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success px-4">
                                    Activar Partido
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
