@using System.Security.Claims
@{
    ViewData["Title"] = "Panel de Control";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Administrator");
    var isLeader = User.IsInRole("PoliticalLeader");
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Usuario";
}

<div class="container py-5">
    @if (isAuthenticated)
    {
        <!-- Encabezado de Bienvenida -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-4 bg-light rounded border">
                    <h1 class="h3 mb-2 text-dark">Bienvenido, @fullName</h1>
                    <p class="text-muted mb-0">
                        Sesión iniciada como 
                        <span class="badge bg-secondary">
                            @(isAdmin ? "Administrador" : "Dirigente Político")
                        </span>
                    </p>
                </div>
            </div>
        </div>

        @if (isAdmin)
        {
            <!-- Panel de Administrador -->
            <h2 class="h5 mb-3 text-secondary text-uppercase" style="letter-spacing: 0.5px; font-weight: 600;">Panel de Administración</h2>
            <div class="row g-4">
                <!-- Usuarios -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-primary font-weight-bold">Usuarios</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Gestiona los accesos del personal administrativo y dirigentes del sistema.
                            </p>
                            <a asp-controller="User" asp-action="Index" class="btn btn-outline-primary w-100 mt-3">Ir a Usuarios</a>
                        </div>
                    </div>
                </div>

                <!-- Partidos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-primary font-weight-bold">Partidos Políticos</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Administra los partidos políticos registrados, sus logos y estados.
                            </p>
                            <a asp-controller="PoliticalParty" asp-action="Index" class="btn btn-outline-primary w-100 mt-3">Ir a Partidos</a>
                        </div>
                    </div>
                </div>

                <!-- Puestos Electivos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-primary font-weight-bold">Puestos Electivos</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Define los cargos y puestos disponibles para las postulaciones electorales.
                            </p>
                            <a asp-controller="ElectedOffice" asp-action="Index" class="btn btn-outline-primary w-100 mt-3">Ir a Puestos</a>
                        </div>
                    </div>
                </div>

                <!-- Ciudadanos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-primary font-weight-bold">Ciudadanos</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Mantenimiento del padrón electoral y validación de documentos de identidad.
                            </p>
                            <a asp-controller="Citizen" asp-action="Index" class="btn btn-outline-primary w-100 mt-3">Ir a Ciudadanos</a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (isLeader)
        {
            <!-- Panel de Dirigente -->
            <h2 class="h5 mb-3 text-secondary text-uppercase" style="letter-spacing: 0.5px; font-weight: 600;">Panel de Dirigente</h2>
            <div class="row g-4">
                <!-- Alianzas -->
                <div class="col-md-6">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-success font-weight-bold">Alianzas Políticas</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Gestiona las alianzas políticas con otros partidos o revisa solicitudes recibidas.
                            </p>
                            <a asp-controller="PoliticalAlliance" asp-action="Index" class="btn btn-outline-success w-100 mt-3">Ir a Alianzas</a>
                        </div>
                    </div>
                </div>

                <!-- Candidatos -->
                <div class="col-md-6">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-success font-weight-bold">Candidatos</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Postula candidatos de tu partido político a los diferentes cargos electivos.
                            </p>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success w-100 mt-3">Ir a Candidatos</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Vista pública / Elector -->
        <div class="row justify-content-center text-center py-5">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold text-dark mb-3">eVote360 Pro</h1>
                <p class="lead text-muted mb-4">
                    Plataforma Oficial de Gestión Electoral y Votación Electrónica.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Voter" asp-action="Index" class="btn btn-primary btn-lg px-4" style="border-radius: 8px;">Votar Aquí (Ciudadanos)</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4" style="border-radius: 8px;">Acceso JCE / Dirigentes Políticos</a>
                </div>
            </div>
        </div>
    }
</div>