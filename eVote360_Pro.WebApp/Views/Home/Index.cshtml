@model eVote360_Pro.Core.Application.DTOs.Dashboard.DashboardGetDto
@using System.Security.Claims
@{
    ViewData["Title"] = "Panel de Control";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Administrator");
    var isLeader = User.IsInRole("PoliticalLeader");
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Usuario";
}

<div class="container py-4">
    @if (isAuthenticated)
    {
        <!-- Encabezado de Bienvenida -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-4 bg-light rounded border border-secondary-subtle shadow-sm">
                    <h1 class="h3 mb-2 text-dark">Bienvenido, @fullName</h1>
                    <p class="text-muted mb-0">
                        Sesión iniciada como 
                        <span class="badge bg-secondary px-2 py-1">
                            @(isAdmin ? "Administrador" : "Dirigente Político")
                        </span>
                    </p>
                </div>
            </div>
        </div>

        @if (isAdmin && Model != null)
        {
            <!-- Panel de Administrador (Dashboard Ejecutivo) -->
            <h2 class="h5 mb-4 text-secondary text-uppercase" style="letter-spacing: 0.5px; font-weight: 600;">Resumen Ejecutivo</h2>
            
            <!-- Fila de KPIs Superiores -->
            <div class="row g-4 mb-5">
                <!-- KPI: Usuarios -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="text-uppercase text-muted mb-0 small font-weight-bold" style="letter-spacing: 0.5px;">Usuarios</h6>
                                </div>
                                <span class="h2 font-weight-bold text-dark d-block mb-1">@Model.TotalUsers</span>
                                <small class="text-success fw-semibold">
                                    ● @Model.ActiveUsers activos
                                </small>
                            </div>
                            <a asp-controller="User" asp-action="Index" class="btn btn-sm btn-outline-primary w-100 mt-3" style="border-radius: 6px;">Gestionar Usuarios</a>
                        </div>
                    </div>
                </div>

                <!-- KPI: Partidos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="text-uppercase text-muted mb-0 small font-weight-bold" style="letter-spacing: 0.5px;">Partidos Políticos</h6>
                                </div>
                                <span class="h2 font-weight-bold text-dark d-block mb-1">@Model.TotalParties</span>
                                <small class="text-muted">Partidos en el sistema</small>
                            </div>
                            <a asp-controller="PoliticalParty" asp-action="Index" class="btn btn-sm btn-outline-success w-100 mt-3" style="border-radius: 6px;">Gestionar Partidos</a>
                        </div>
                    </div>
                </div>

                <!-- KPI: Puestos -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="text-uppercase text-muted mb-0 small font-weight-bold" style="letter-spacing: 0.5px;">Puestos Electivos</h6>
                                </div>
                                <span class="h2 font-weight-bold text-dark d-block mb-1">@Model.TotalElectedOffices</span>
                                <small class="text-muted">Cargos en contienda</small>
                            </div>
                            <a asp-controller="ElectedOffice" asp-action="Index" class="btn btn-sm btn-outline-warning w-100 mt-3" style="border-radius: 6px;">Gestionar Puestos</a>
                        </div>
                    </div>
                </div>

                <!-- KPI: Ciudadanos (Padrón) -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="text-uppercase text-muted mb-0 small font-weight-bold" style="letter-spacing: 0.5px;">Padrón Electoral</h6>
                                </div>
                                <span class="h2 font-weight-bold text-dark d-block mb-1">@Model.TotalCitizens</span>
                                <small class="text-success fw-semibold">
                                    ● @Model.ActiveCitizens activos
                                </small>
                            </div>
                            <a asp-controller="Citizen" asp-action="Index" class="btn btn-sm btn-outline-info w-100 mt-3" style="border-radius: 6px;">Gestionar Ciudadanos</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fila de Elección Activa y Resultados -->
            @if (!string.IsNullOrEmpty(Model.ResultsElectionName))
            {
                <div class="row g-4">
                    <!-- Participación Electoral (Panel Izquierdo) -->
                    <div class="col-lg-4">
                        <div class="card border-secondary-subtle shadow-sm h-100">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="h6 text-uppercase text-muted mb-3 font-weight-bold" style="letter-spacing: 0.5px;">Participación Electoral</h5>
                                    <h3 class="h5 text-dark font-weight-bold mb-1">@Model.ResultsElectionName</h3>
                                    <p class="text-muted small mb-4">
                                        Estado: 
                                        <span class="badge @(Model.ResultsElectionStatus == "Activa" ? "bg-primary" : "bg-success")">
                                            @Model.ResultsElectionStatus
                                        </span>
                                    </p>
                                    
                                    <div class="text-center my-4">
                                        <span class="display-4 font-weight-bold text-primary">@Model.VotingParticipationPercentage%</span>
                                        <p class="text-muted small mb-0">Votos emitidos del padrón total</p>
                                    </div>

                                    <div class="progress mb-3" style="height: 10px; border-radius: 5px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" 
                                             style="width: @Model.VotingParticipationPercentage%" 
                                             aria-valuenow="@Model.VotingParticipationPercentage" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100"></div>
                                    </div>
                                </div>

                                <div class="border-top pt-3">
                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span>Votos Depositados:</span>
                                        <strong class="text-dark">@Model.VotedCitizensCount</strong>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small">
                                        <span>Ciudadanos Habilitados:</span>
                                        <strong class="text-dark">@Model.TotalCitizens</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Avance y Resultados por Cargo (Panel Derecho) -->
                    <div class="col-lg-8">
                        <div class="card border-secondary-subtle shadow-sm h-100">
                            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                                <h5 class="h6 text-uppercase text-muted mb-0 font-weight-bold" style="letter-spacing: 0.5px;">
                                    @(Model.ResultsElectionStatus == "Activa" ? "Avance de Resultados en Tiempo Real" : "Resultados Finales del Sufragio")
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                @if (Model.ElectionResults.Any())
                                {
                                    <div class="accordion border-0" id="resultsAccordion">
                                        @for (int i = 0; i < Model.ElectionResults.Count; i++)
                                        {
                                            var office = Model.ElectionResults[i];
                                            <div class="accordion-item border-secondary-subtle mb-3 rounded shadow-sm overflow-hidden">
                                                <h2 class="accordion-header" id="heading-@i">
                                                    <button class="accordion-button collapsed fw-bold text-dark py-3" type="button" 
                                                            data-bs-toggle="collapse" data-bs-target="#collapse-@i" 
                                                            aria-expanded="false" aria-controls="collapse-@i">
                                                        <div class="d-flex justify-content-between w-100 align-items-center pe-3">
                                                            <span>@office.OfficeName</span>
                                                            <span class="badge bg-secondary font-weight-normal small">@office.TotalVotes votos</span>
                                                        </div>
                                                    </button>
                                                </h2>
                                                <div id="collapse-@i" class="accordion-collapse collapse" aria-labelledby="heading-@i" data-bs-parent="#resultsAccordion">
                                                    <div class="accordion-body bg-light p-4">
                                                        @if (office.Candidates.Any())
                                                        {
                                                            foreach (var candidate in office.Candidates)
                                                            {
                                                                <div class="mb-4">
                                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                                        <div class="d-flex align-items-center">
                                                                            @if (!string.IsNullOrEmpty(candidate.Photo))
                                                                            {
                                                                                <img src="@candidate.Photo" alt="@candidate.CandidateName" 
                                                                                     class="rounded-circle me-2 border border-secondary-subtle" 
                                                                                     style="width: 32px; height: 32px; object-fit: cover;" />
                                                                            }
                                                                            <div>
                                                                                <strong class="text-dark">@candidate.CandidateName</strong>
                                                                                <span class="text-muted small">(@(candidate.PartyAcronym ?? "Sin partido"))</span>
                                                                                @if (candidate.IsWinner && Model.ResultsElectionStatus == "Finalizada")
                                                                                {
                                                                                    <span class="badge bg-success ms-2">Ganador</span>
                                                                                }
                                                                                @if (candidate.IsTie && Model.ResultsElectionStatus == "Finalizada")
                                                                                {
                                                                                    <span class="badge bg-warning text-dark ms-2">Empate</span>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                        <div>
                                                                            <span class="text-dark fw-bold">@candidate.Percentage%</span>
                                                                            <span class="text-muted small ms-2">(@candidate.VoteCount votos)</span>
                                                                        </div>
                                                                    </div>
                                                                    <div class="progress" style="height: 8px; border-radius: 4px;">
                                                                        <div class="progress-bar @(candidate.IsWinner ? "bg-success" : "bg-info")" role="progressbar" 
                                                                             style="width: @candidate.Percentage%" 
                                                                             aria-valuenow="@candidate.Percentage" 
                                                                             aria-valuemin="0" 
                                                                             aria-valuemax="100"></div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <p class="text-muted small mb-0">No hay candidatos postulados para esta categoría.</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted">
                                        Aún no se han registrado votos en esta elección.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center border-0 py-4 shadow-sm rounded-4">
                    <h4 class="h5 font-weight-bold">No hay elecciones activas o finalizadas</h4>
                    <p class="text-muted mb-3">Registra y activa una elección en el sistema para visualizar las métricas y reportes electorales.</p>
                    <a asp-controller="Election" asp-action="Index" class="btn btn-primary px-4" style="border-radius: 6px;">Ir a Gestión de Elecciones</a>
                </div>
            }
        }
        else if (isLeader)
        {
            <!-- Panel de Dirigente -->
            <h2 class="h5 mb-4 text-secondary text-uppercase" style="letter-spacing: 0.5px; font-weight: 600;">Panel de Dirigente</h2>
            <div class="row g-4">
                <!-- Alianzas -->
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-success font-weight-bold">Alianzas Políticas</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Gestiona las alianzas políticas con otros partidos o revisa solicitudes recibidas.
                            </p>
                            <a asp-controller="PoliticalAlliance" asp-action="Index" class="btn btn-outline-success w-100 mt-3" style="border-radius: 6px;">Ir a Alianzas</a>
                        </div>
                    </div>
                </div>

                <!-- Candidatos -->
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-success font-weight-bold">Candidatos</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Postula candidatos de tu partido político a los diferentes cargos electivos.
                            </p>
                            <a asp-controller="Candidate" asp-action="Index" class="btn btn-outline-success w-100 mt-3" style="border-radius: 6px;">Ir a Candidatos</a>
                        </div>
                    </div>
                </div>

                <!-- Asignación -->
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-secondary-subtle shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 card-title text-success font-weight-bold">Asignación de Puestos</h3>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.9rem;">
                                Asigna tus candidatos a puestos disponibles o postula a tus candidatos aliados.
                            </p>
                            <a asp-controller="CandidateOfficeAssignment" asp-action="Index" class="btn btn-outline-success w-100 mt-3" style="border-radius: 6px;">Ir a Asignaciones</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Vista pública / Elector -->
        <div class="row justify-content-center text-center py-5 my-5">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold text-dark mb-3">eVote360 Pro</h1>
                <p class="lead text-muted mb-4">
                    Plataforma Oficial de Gestión Electoral y Votación Electrónica.
                </p>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <a asp-controller="Voter" asp-action="Index" class="btn btn-primary btn-lg px-4" style="border-radius: 8px;">Votar Aquí (Ciudadanos)</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4" style="border-radius: 8px;">Acceso JCE / Dirigentes Políticos</a>
                </div>
            </div>
        </div>
    }
</div>