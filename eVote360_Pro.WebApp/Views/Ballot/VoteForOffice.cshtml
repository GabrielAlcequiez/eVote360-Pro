@model VoteCandidateViewModel
@{
    ViewData["Title"] = $"Votar - {Model.OfficeName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
                    ← Volver a puestos electivos
                </a>
            </div>

            <div class="mb-4">
                <h2 class="h3 font-weight-bold mb-1" style="color: #0f172a;">@Model.OfficeName</h2>
                <p class="text-muted mb-0" style="font-size: 0.9rem;">Seleccione el candidato de su preferencia para este puesto.</p>
            </div>

            <form asp-action="VoteForOffice" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OfficeId" />

                @for (int i = 0; i < Model.Candidates.Count; i++)
                {
                    <div class="card border-0 shadow-sm mb-3 candidate-card @(Model.SelectedCandidateId == Model.Candidates[i].CandidateId ? "border border-2 border-primary" : "")" style="border-radius: 16px; overflow: hidden; cursor: pointer;" onclick="selectCandidate(@i)">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check">
                                    <input type="radio" class="form-check-input" asp-for="SelectedCandidateId" value="@Model.Candidates[i].CandidateId"
                                           id="candidate-@Model.Candidates[i].CandidateId"
                                           onchange="highlightCard(this)"
                                           checked="@(Model.SelectedCandidateId == Model.Candidates[i].CandidateId)" />
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Candidates[i].Photo))
                                {
                                    <img src="@Model.Candidates[i].Photo" alt="@Model.Candidates[i].FullName" class="rounded-circle" style="width: 56px; height: 56px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-muted" style="width: 56px; height: 56px; font-size: 1.2rem;">
                                        <span>@Model.Candidates[i].FullName[0]</span>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <h5 class="mb-1" style="color: #0f172a; font-weight: 600;">@Model.Candidates[i].FullName</h5>
                                    <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.85rem;">
                                        @if (!string.IsNullOrEmpty(Model.Candidates[i].PartyLogo))
                                        {
                                            <img src="@Model.Candidates[i].PartyLogo" alt="@Model.Candidates[i].PartyAcronym" style="width: 24px; height: 24px; object-fit: cover;" />
                                        }
                                        <span>@Model.Candidates[i].PartyName (@Model.Candidates[i].PartyAcronym)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" asp-for="Candidates[i].CandidateId" />
                    <input type="hidden" asp-for="Candidates[i].FullName" />
                    <input type="hidden" asp-for="Candidates[i].Photo" />
                    <input type="hidden" asp-for="Candidates[i].PartyName" />
                    <input type="hidden" asp-for="Candidates[i].PartyAcronym" />
                    <input type="hidden" asp-for="Candidates[i].PartyLogo" />
                }

                <!-- Opción Ninguno -->
                <div class="card border-0 shadow-sm mb-3 candidate-card @(Model.SelectedCandidateId == null ? "border border-2 border-primary" : "")" style="border-radius: 16px; overflow: hidden; cursor: pointer;" onclick="selectNinguno()">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="SelectedCandidateId" value=""
                                       id="candidate-ninguno"
                                       onchange="highlightCard(this)"
                                       checked="@(Model.SelectedCandidateId == null ? true : false)" />
                            </div>
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-muted" style="width: 56px; height: 56px; font-size: 1.2rem;">
                                <span>—</span>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="mb-0" style="color: #64748b; font-weight: 600;">Ninguno</h5>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border: none;">
                        Guardar selección
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectCandidate(index) {
            var radios = document.querySelectorAll('input[name="SelectedCandidateId"]');
            if (radios.length > index) {
                radios[index].checked = true;
                highlightCard(radios[index]);
            }
        }

        function selectNinguno() {
            var radio = document.getElementById('candidate-ninguno');
            if (radio) {
                radio.checked = true;
                highlightCard(radio);
            }
        }

        function highlightCard(radio) {
            document.querySelectorAll('.candidate-card').forEach(function(card) {
                card.classList.remove('border', 'border-2', 'border-primary');
            });
            var card = radio.closest('.candidate-card');
            if (card) {
                card.classList.add('border', 'border-2', 'border-primary');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('input[name="SelectedCandidateId"]').forEach(function(radio) {
                if (radio.checked) {
                    highlightCard(radio);
                }
            });
        });
    </script>
}
