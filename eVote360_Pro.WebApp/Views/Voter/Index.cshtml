@model eVote360_Pro.WebApp.Models.Voter.VoterDocumentViewModel
@{
    ViewData["Title"] = "Validación de Cédula";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-center mb-4">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="card shadow-sm border-secondary-subtle">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="h3 font-weight-bold text-dark">Portal de Votación</h2>
                    <p class="text-muted">Paso 1: Verificación de Elegibilidad del Elector</p>
                </div>

                <!-- Pasos de Progreso -->
                <div class="d-flex justify-content-around align-items-center mb-4">
                    <span class="badge bg-primary px-3 py-2">1. Cédula</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-light text-secondary px-3 py-2 border">2. Foto OCR</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-light text-secondary px-3 py-2 border">3. Código OTP</span>
                </div>

                <form asp-action="Index" asp-controller="Voter" method="post" id="voterForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-4">
                        <label asp-for="DocumentNumber" class="form-label font-weight-bold">Número de Cédula</label>
                        <input asp-for="DocumentNumber" class="form-control form-control-lg text-center" id="cedulaInput" placeholder="001-0000000-0" autocomplete="off" autofocus style="letter-spacing: 1px;" />
                        <span asp-validation-for="DocumentNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-2">Votar</button>
                </form>

                <p class="text-muted text-center mt-4 small" style="line-height: 1.4;">
                    El sistema comprobará si te encuentras registrado y habilitado en el padrón electoral, que exista una elección activa y que aún no hayas ejercido el voto.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cedulaInput = document.getElementById('cedulaInput');
        if (cedulaInput) {
            cedulaInput.addEventListener('input', function (e) {
                let val = e.target.value.replace(/\D/g, '');
                if (val.length > 11) {
                    val = val.substring(0, 11);
                }
                
                let formatted = '';
                if (val.length > 0) {
                    formatted += val.substring(0, Math.min(val.length, 3));
                }
                if (val.length > 3) {
                    formatted += '-' + val.substring(3, Math.min(val.length, 10));
                }
                if (val.length > 10) {
                    formatted += '-' + val.substring(10, 11);
                }
                
                e.target.value = formatted;
            });
        }
    </script>
}
