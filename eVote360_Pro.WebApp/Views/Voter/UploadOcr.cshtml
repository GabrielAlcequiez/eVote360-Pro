@model eVote360_Pro.WebApp.Models.Voter.VoterOcrViewModel
@{
    ViewData["Title"] = "Validación de Documento (OCR)";
}

<style>
    /* Estilo de zona de arrastre estándar y limpio */
    .drag-drop-box {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        background-color: #f8fafc;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .drag-drop-box:hover, .drag-drop-box.dragover {
        border-color: #0d6efd;
        background-color: #f1f5f9;
    }
    .preview-box {
        display: none;
        text-align: center;
        margin-top: 15px;
    }
    .preview-img {
        max-width: 100%;
        max-height: 250px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }
    /* Spinner Overlay estándar */
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        border-radius: .375rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
    .loading-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }
</style>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        
        <div class="card shadow-sm border-secondary-subtle position-relative">
            <!-- Loading Overlay -->
            <div class="loading-overlay" id="loadingOverlay">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <h4 class="h5 text-dark font-weight-bold">Procesando Imagen OCR</h4>
                <p class="text-muted text-center px-4 small">Estamos analizando tu documento de identidad mediante inteligencia artificial. Por favor, no cierres esta ventana.</p>
            </div>

            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="h3 font-weight-bold text-dark">Portal de Votación</h2>
                    <p class="text-muted">Paso 2: Validación OCR de la Cédula</p>
                </div>

                <!-- Pasos de Progreso -->
                <div class="d-flex justify-content-around align-items-center mb-4">
                    <span class="badge bg-success px-3 py-2">✓ Cédula</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-primary px-3 py-2">2. Foto OCR</span>
                    <span class="text-muted">→</span>
                    <span class="badge bg-light text-secondary px-3 py-2 border">3. Código OTP</span>
                </div>

                <div class="alert alert-info text-center py-2 mb-4">
                    Documento ingresado: <strong id="formattedDoc">@Model.DocumentNumber</strong>
                </div>

                <form asp-action="UploadOcr" asp-controller="Voter" method="post" enctype="multipart/form-data" id="ocrForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DocumentNumber" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

                    <div class="mb-4">
                        <label class="form-label d-block text-center font-weight-bold mb-3">Sube una foto clara de tu cédula</label>
                        
                        <div class="drag-drop-box" id="uploadArea">
                            <span style="font-size: 2.5rem; display: block; margin-bottom: 10px;">🪪</span>
                            <span class="text-primary fw-semibold d-block" id="uploadText">Haz clic para buscar o arrastra la foto aquí</span>
                            <span class="text-muted small" id="uploadSubtext">Formatos válidos: JPG, PNG (máx. 5MB)</span>
                            <input type="file" asp-for="DocumentImage" id="fileInput" accept="image/png, image/jpeg, image/jpg" style="display: none;" />
                        </div>
                        <span asp-validation-for="DocumentImage" class="text-danger small mt-1 d-block text-center"></span>

                        <!-- Preview -->
                        <div class="preview-box" id="previewContainer">
                            <img src="" alt="Vista previa de cédula" class="preview-img" id="previewImage" />
                            <div class="mt-3">
                                <button type="button" class="btn btn-sm btn-outline-danger" id="btnRemoveImage">
                                    Quitar foto y cambiar
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 py-2" id="btnSubmit">Validar identidad</button>
                    <a asp-action="Index" asp-controller="Voter" class="btn btn-outline-secondary w-100 mt-2">← Volver Atrás</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Formatear cédula
        const formattedDoc = document.getElementById('formattedDoc');
        if (formattedDoc) {
            let val = formattedDoc.innerText.replace(/\D/g, '');
            if (val.length === 11) {
                formattedDoc.innerText = val.substring(0, 3) + '-' + val.substring(3, 10) + '-' + val.substring(10, 11);
            }
        }

        // Drag and drop logic
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('fileInput');
        const previewContainer = document.getElementById('previewContainer');
        const previewImage = document.getElementById('previewImage');
        const btnRemoveImage = document.getElementById('btnRemoveImage');
        const ocrForm = document.getElementById('ocrForm');
        const loadingOverlay = document.getElementById('loadingOverlay');

        uploadArea.addEventListener('click', () => fileInput.click());

        ['dragenter', 'dragover'].forEach(eventName => {
            uploadArea.addEventListener(eventName, (e) => {
                e.preventDefault();
                uploadArea.classList.add('dragover');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, (e) => {
                e.preventDefault();
                uploadArea.classList.remove('dragover');
            }, false);
        });

        uploadArea.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;
            if (files.length > 0) {
                fileInput.files = files;
                handleFiles(files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFiles(e.target.files[0]);
            }
        });

        function handleFiles(file) {
            if (!file.type.match('image.*')) {
                alert('Por favor, selecciona únicamente archivos de imagen.');
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                uploadArea.style.display = 'none';
                previewContainer.style.display = 'block';
            }
            reader.readAsDataURL(file);
        }

        btnRemoveImage.addEventListener('click', () => {
            fileInput.value = '';
            previewImage.src = '';
            previewContainer.style.display = 'none';
            uploadArea.style.display = 'block';
        });

        ocrForm.addEventListener('submit', (e) => {
            if (fileInput.files.length > 0) {
                loadingOverlay.classList.add('active');
            }
        });
    </script>
}
