@model List<ElectedOfficeGetViewModel>
@{
    ViewData["Title"] = "Puestos Electorales";
}

<div class="row">
    <div>
        <h1 class="display-4 text-center">Listado de Puestos Electivos</h1>
    </div>
</div>

<div class="container-fluid px-4">
     <div class="d-flex justify-content-between align-items-center my-4">
        <h2 class="text-secondary fw-bold">Mantenimiento de Puestos Electivos</h2>
        <a asp-controller="ElectedOffice" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Puesto Electivo
        </a>
    </div>

    <div class="row g-4 mt-2">
        @if (!Model.Any())
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-person-badge display-1 d-block mb-3"></i>
                <p>No hay puestos electivos registrados en el sistema actualmente.</p>
            </div>
        }
        else
        {
            @foreach (var electedOffice in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 position-relative">

                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill @(electedOffice.IsActive ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                            @(electedOffice.IsActive ? "Activo" : "Inactivo")
                        </span>

                        <div class="card-body d-flex flex-column pt-4">
                            <span class="text-uppercase text-muted fw-bold small tracking-wider mb-1">
                                @electedOffice.Name
                            </span>

                            <p class="card-text text-muted small mb-4 flex-grow-1" title="@electedOffice.Description">
                                @electedOffice.Description
                            </p>

                            <div class="pt-2 border-top">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <a asp-action="Edit" asp-route-id="@electedOffice.Id" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-pencil-square me-2"></i> Editar
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-action="Delete" asp-route-id="@electedOffice.Id" class="btn btn-sm btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                                            <i class="bi bi-trash3 me-2"></i> Eliminar
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

