@{
    ViewData["Title"] = "Resultados Electorales";
    string electionName = ViewBag.ElectionName;
}

<div class="container py-4">
    <div class="mb-3 d-flex align-items-center justify-content-between">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
            ← Volver al listado
        </a>
    </div>

    <div class="text-center py-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#64748b" viewBox="0 0 16 16" class="mb-3">
            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
        <h2 class="h3 font-weight-bold mb-1" style="color: #0f172a;">@electionName</h2>
        <p class="text-muted mb-4">Los resultados detallados estarán disponibles una vez se implemente el módulo de votación.</p>
    </div>
</div>
