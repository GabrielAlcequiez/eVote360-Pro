@model Guid
@{
    ViewData["Title"] = "Finalizar Elección";
    string electionName = ViewBag.ElectionName;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm p-4 p-md-5 text-center" style="border-radius: 20px; background: #ffffff;">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#f59e0b" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                </div>

                <h2 class="h3 font-weight-bold mb-2" style="color: #0f172a;">¿Está seguro que desea finalizar esta elección?</h2>
                <p class="text-muted mb-4" style="font-size: 1rem;">
                    Al finalizar <strong>@electionName</strong>, no se permitirán nuevos votos y los resultados quedarán disponibles para consulta.
                </p>

                <p class="text-muted mb-4" style="font-size: 0.85rem;">
                    Esta acción no se puede deshacer.
                </p>

                <form asp-action="FinishConfirmed" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">Cancelar</a>
                        <button type="submit" class="btn btn-warning px-4 py-2" style="border-radius: 10px; color: white;">
                            Finalizar elección
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
