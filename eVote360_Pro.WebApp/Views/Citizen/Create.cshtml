@model CitizenCreateViewModel
@{
    ViewData["Title"] = "Registrar Ciudadano";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="mb-3 d-flex align-items-center justify-content-between">
                <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
                    ← Volver al listado
                </a>
            </div>

            <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 20px; background: #ffffff;">
                <div class="mb-4">
                    <h2 class="h3 font-weight-bold mb-1" style="color: #0f172a; font-weight: 700;">@ViewData["Title"]</h2>
                    <p class="text-muted mb-0" style="font-size: 0.9rem;">Registra un nuevo ciudadano en el sistema.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 p-3 mb-4" style="border-radius: 12px; background-color: rgba(239, 68, 68, 0.1); color: #991b1b; font-size: 0.9rem;"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Nombre</label>
                        <input asp-for="Name" class="form-control" placeholder="Ej: Juan" style="border-radius: 10px; padding: 10px 14px;" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Apellido</label>
                        <input asp-for="LastName" class="form-control" placeholder="Ej: Pérez" style="border-radius: 10px; padding: 10px 14px;" />
                        <span asp-validation-for="LastName" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Correo electrónico</label>
                        <input asp-for="Email" class="form-control" placeholder="Ej: juan.perez@email.com" style="border-radius: 10px; padding: 10px 14px;" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DocumentNumber" class="form-label" style="font-size: 0.85rem; font-weight: 500; color: #475569;">Número de documento</label>
                        <input asp-for="DocumentNumber" class="form-control" id="cedulaInput" placeholder="001-0000000-0" style="border-radius: 10px; padding: 10px 14px;" autocomplete="off" />
                        <span asp-validation-for="DocumentNumber" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); border: none;">
                            Crear ciudadano
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const cedulaInput = document.getElementById('cedulaInput');
        if (cedulaInput) {
            cedulaInput.addEventListener('input', function (e) {
                let val = e.target.value.replace(/\D/g, '');
                if (val.length > 11) {
                    val = val.substring(0, 11);
                }
                
                let formatted = '';
                if (val.length > 0) {
                    formatted += val.substring(0, Math.min(val.length, 3));
                }
                if (val.length > 3) {
                    formatted += '-' + val.substring(3, Math.min(val.length, 10));
                }
                if (val.length > 10) {
                    formatted += '-' + val.substring(10, 11);
                }
                
                e.target.value = formatted;
            });
        }
    </script>
}
